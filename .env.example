# ==============================================================================
# SIDDHIVINAYAK TOURS & TRAVELS — PRODUCTION BACKEND CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in the project root to configure Email & SMS delivery.
#
# IMPORTANT SECURITY:
# 1. These variables are STRICTLY SERVER-SIDE.
# 2. DO NOT prefix with VITE_ to keep API keys secure and hidden from the browser.
# 3. Add .env to your .gitignore (never commit real credentials to git).
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: SMTP / NODEMAILER (RECOMMENDED FOR DEVELOPMENT & UNIVERSAL DELIVERY)
# ------------------------------------------------------------------------------
# No custom domain verification required! Works with Gmail App Passwords,
# Brevo, SendGrid, Mailgun, or any standard SMTP server.
#
# For Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Create an App Password at: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character App Password in SMTP_PASS below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Siddhivinayak Tours" <your_email@gmail.com>

# Or specify a well-known service (e.g. gmail):
# SMTP_SERVICE=gmail


# ------------------------------------------------------------------------------
# OPTION 2: EMAIL OTP — RESEND API (https://resend.com)
# ------------------------------------------------------------------------------
# If you prefer Resend API:
# Note: On Resend free tier without a verified domain, delivery is restricted
# by Resend to your account email. Verify a domain at resend.com/domains for
# universal delivery, or use Option 1 (SMTP) above.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev


# ------------------------------------------------------------------------------
# 3. SMS OTP — FAST2SMS INDIA (https://www.fast2sms.com)
# ------------------------------------------------------------------------------
# Create an account at https://www.fast2sms.com, get your Dev API key from:
# https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# DLT Approved Sender ID (Optional, defaults to SDVTUR / Fast2SMS quick route)
FAST2SMS_SENDER_ID=SDVTUR
